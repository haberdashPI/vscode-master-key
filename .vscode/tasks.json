// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install-debug-extensions",
            "type": "shell",
            "command": "code --profile master-key-debug --install-extension tamasfe.even-better-toml --install-extension haberdashPI.selection-utilities",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "mise: watch build",
            "type": "shell",
            "command": "mise build_watch",
            "problemMatcher": [
                {
                    "applyTo": "allDocuments",
                    "source": "esbuild",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^\\[build_watch\\] [✘▲] \\[([A-Z]+)\\] (.+)",
                            "severity": 1,
                            "message": 2
                        },
                        {
                            "regexp": "^\\[build_watch\\] (?:\\t| {4})(?!\\s)([^:]+)(?::([0-9]+))?(?::([0-9]+))?:$",
                            "file": 1,
                            "line": 2,
                            "column": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": {
                            "regexp": "^\\[build_watch\\]\\s*\\[watch\\] build started"
                        },
                        "endsPattern": {
                            "regexp": "^\\[build_watch\\]\\s*\\[watch\\] build finished"
                        }
                    }
                },
                {
                    "applyTo": "allDocuments",
                    "source": "tsc",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^\\[lint\\]\\s+([0-9]+):([0-9]+)\\s*([a-z]+)\\s*(.*)$",
                            "line": 1,
                            "column": 2,
                            "severity": 3,
                            "message": 4
                        },
                        {
                            "regexp": "^\\[lint\\]\\s(.*ts)\\s*$",
                            "file": 1,
                            "line": 2
                        }
                    ]
                }
            ],
            "isBackground": true,
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "label": "prepare-and-watch",
            "dependsOn": [
                "install-debug-extensions",
                "mise: watch build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
